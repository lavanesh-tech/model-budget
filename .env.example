ENVIRONMENT=development
POSTGRES_DB=modelbudget
POSTGRES_USER=modelbudget
POSTGRES_PASSWORD=replace_with_local_password

# Upstream credential used by THIS gateway to call the OpenAI API.
# Never commit a real value here. Leave blank/unset to run only against
# the free deterministic MockProvider -- OpenAI is never used unless
# this is explicitly set.
# OPENAI_API_KEY=sk-replace-with-your-real-openai-key

# Model identifier this gateway requests from OpenAI when the "openai"
# provider is selected. Verify current availability and pricing before
# changing this (see app/services/pricing.py's OpenAI catalog entry and
# its note that OpenAI pricing must be reviewed before production use).
OPENAI_MODEL=gpt-5-mini

# Optional: override the OpenAI API base URL (e.g. for a proxy or an
# OpenAI-compatible endpoint). Leave blank to use OpenAI's default.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: OpenAI organization ID, if your account belongs to more than one.
# OPENAI_ORGANIZATION=org-replace-me

# Optional: OpenAI project ID, for per-project usage/billing separation.
# OPENAI_PROJECT=proj_replace_me

# NOTE ON CLIENT AUTH TO THIS GATEWAY (not an OpenAI setting):
# External callers authenticate to THIS gateway with a per-team API key
# in the form mb_<public_key_id>.<secret>, created via
# `python scripts/bootstrap_team.py` (see app/security/api_keys.py and
# app/models/api_key.py). Those keys are stored only as Argon2id hashes
# in the database. There is no single gateway-wide client-key setting to
# configure here -- each team has its own key.

# Connection URL for distributed rate limiting (see
# app/services/rate_limit.py). Points at the local Docker Compose redis
# service by default. In production (e.g. AWS ElastiCache for Redis),
# override with the real endpoint -- possibly including an AUTH token
# (redis://:TOKEN@host:6379/0) or TLS (rediss://...). Never commit a
# real production value here. Postgres remains the durable system of
# record for teams/budgets/idempotency/usage; Redis holds ONLY
# ephemeral rate-limit counters.
REDIS_URL=redis://127.0.0.1:6379/0

# Requests allowed per team within the sliding window below (see
# app/services/rate_limit.py's atomic Lua sliding-window-log limiter).
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
